# 보통은 프로그램 화면의 ⚙️ 설정에서 키를 입력하면 돼요. (이 파일은 선택)

# 필수: 대본 작성 (Claude)
ANTHROPIC_API_KEY=

# 추천: 목소리 (ElevenLabs). 있으면 OpenAI보다 우선 사용
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2   # 또는 eleven_flash_v2_5, eleven_v3

# 추천: 무료 스톡 영상 (Pexels 우선, Pixabay 대체)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# 선택: AI 이미지 생성 + 목소리 대체 (OpenAI)
OPENAI_API_KEY=

# API 키 없이 화면만 체험하려면 1 (예시 대본 사용)
# DEMO_MODE=1
# PORT=3000

# ---- 수업 서버 모드 (링크 하나로 반 전체 사용) ----
# CLASS_CODE=reels2026        # 설정하면 수업 서버 모드: 학생은 이 코드로 입장, 키는 환경변수에서만 읽음
# RENDER_CONCURRENCY=1        # 동시에 만드는 릴스 수 (기본: CPU 2개당 1편)
# UPLOAD_LIMIT_MB=50          # 파일 하나 최대 크기
# KEEP_HOURS=24               # 학생 작업물 보관 시간
