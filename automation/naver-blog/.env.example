# 네이버 개발자센터(https://developers.naver.com)에서 애플리케이션 등록 후 발급받은 값
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# scripts/getInitialToken.mjs 를 한 번 실행해서 얻는 값 (최초 1회, 이후 자동 갱신됨)
NAVER_REFRESH_TOKEN=

# 글을 발행할 카테고리 번호 (선택, 비워두면 카테고리 미지정으로 발행)
# node scripts/listCategories.mjs 로 조회 가능
NAVER_CATEGORY_NO=

# 콘텐츠 자동 생성에 사용할 Anthropic API 키 (선택)
# 비워두면 템플릿 기반 콘텐츠로 대체 발행됨
ANTHROPIC_API_KEY=

# 발행 글 공개 범위: all(전체공개, 기본값) | closed(비공개) | neighbor(이웃공개) | agreedNeighbor(서로이웃공개)
NAVER_POST_OPEN_TYPE=all
